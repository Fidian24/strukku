# =====================================================================
# .gitignore STRUKKU (backend FastAPI + aplikasi Flutter)
# JANGAN hapus bagian RAHASIA: berisi password database & kunci JWT.
# =====================================================================

# ---------- RAHASIA (jangan pernah di-upload) ----------
.env
.env.*
!.env.example
!.env.*.example
*.keystore
*.jks
key.properties

# ---------- Backend Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.db
*.db-journal
**/storage/uploads/*
!**/storage/uploads/.gitkeep

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/android/.gradle/
**/android/.kotlin/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/ephemeral/
*.apk
*.aab

# ---------- Editor / sistem ----------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.zip

Claude outputs/
